    <!-- http://www.semanticweb.org/oleyn/ontologies/2022/4/кафедра#ИЗ_ПИиКН_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oleyn/ontologies/2022/4/кафедра#ИЗ_ПИиКН_5">
